-- Use exactly the existing scalar recurrence in the polynomial ring.
noncomputable def HP (R : Type*) [CommRing R] (n : ℕ) : Polynomial R :=
  H (X : Polynomial R) n

@[simp] theorem HP_zero (R : Type*) [CommRing R] : HP R 0 = 1 := rfl
@[simp] theorem HP_one (R : Type*) [CommRing R] : HP R 1 = X + 1 := rfl

theorem HP_rec (R : Type*) [CommRing R] (n : ℕ) :
    HP R (n+2) = X * HP R (n+1) - HP R n := rfl

theorem HP_spec (R : Type*) [CommRing R] [Nontrivial R] (n : ℕ) :
    (HP R n).Monic ∧ (HP R n).natDegree = n := by
  match n with
  | 0 => simp [HP_zero]
  | 1 =>
    rw [HP_one]
    simpa only [C_1] using
      And.intro (monic_X_add_C (1 : R)) (natDegree_X_add_C (1 : R))
  | n+2 =>
    have h0 := HP_spec R n
    have h1 := HP_spec R (n+1)
    have hm : (X * HP R (n+1)).Monic := monic_X.mul h1.1
    have hd : (X * HP R (n+1)).natDegree = n+2 := by
      rw [monic_X.natDegree_mul h1.1, natDegree_X, h1.2]
      omega
    have hl : (HP R n).natDegree < (X * HP R (n+1)).natDegree := by
      rw [h0.2, hd]
      omega
    rw [HP_rec]
    exact ⟨hm.sub_of_left (degree_lt_degree hl),
      (natDegree_sub_eq_left_of_natDegree_lt hl).trans hd⟩
termination_by n

theorem HP_monic (R : Type*) [CommRing R] [Nontrivial R] (n : ℕ) :
    (HP R n).Monic := (HP_spec R n).1

theorem HP_natDegree (R : Type*) [CommRing R] [Nontrivial R] (n : ℕ) :
    (HP R n).natDegree = n := (HP_spec R n).2

theorem H_map {R S : Type*} [Ring R] [Ring S] (f : R →+* S) (z : R) (n : ℕ) :
    f (H z n) = H (f z) n := by
  match n with
  | 0 => simp [H]
  | 1 => simp [H]
  | n+2 =>
    simp only [H, map_sub, map_mul, H_map f z n, H_map f z (n+1)]
termination_by n

theorem HP_aeval {R K : Type*} [CommRing R] [CommRing K] [Algebra R K]
    (z : K) (n : ℕ) : aeval z (HP R n) = H z n := by
  have h := H_map (aeval z : Polynomial R →ₐ[R] K).toRingHom (X : Polynomial R) n
  change aeval z (HP R n) = H (aeval z (X : Polynomial R)) n at h
  simpa only [aeval_X] using h

theorem HP_map {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) (n : ℕ) :
    (HP R n).map f = HP S n := by
  simpa [HP] using H_map (Polynomial.mapRingHom f) (X : Polynomial R) n

-- A primitive root yields a root by the already audited geometric identity.
theorem HP_trace_root {K : Type*} [Field K] [CharZero K] (n : ℕ)
    (hn : 0 < n) {w : K} (hw : IsPrimitiveRoot w (2*n+1)) :
    aeval (w+w⁻¹) (HP ℚ n) = 0 := by
  rw [HP_aeval]
  exact trace_root_of_unity w n (hw.ne_zero (by omega)) (hw.ne_one (by omega)) hw.pow_eq_one

-- Explicit quadratic annihilator of w over E = Q(w + w^-1).
-- This avoids invoking a theorem about complex conjugation or real embeddings.
set_option synthInstance.maxHeartbeats 400000 in
set_option maxHeartbeats 2000000 in
theorem quadratic_degree_bound {K : Type*} [Field K] [CharZero K] {w : K}
    (hw : w ≠ 0) :
    let E := IntermediateField.adjoin ℚ ({w+w⁻¹} : Set K)
    IsIntegral E w ∧ (minpoly E w).natDegree ≤ 2 := by
  dsimp only
  let E := IntermediateField.adjoin ℚ ({w+w⁻¹} : Set K)
  let u : E := ⟨w+w⁻¹, IntermediateField.mem_adjoin_simple_self ℚ _⟩
  let f : Polynomial E := C (-u) * X + 1
  let Q : Polynomial E := X^2 + f
  have hf : f.natDegree ≤ 1 := by
    dsimp [f]
    calc
      _ ≤ max (C (-u) * X).natDegree (1 : Polynomial E).natDegree := natDegree_add_le _ _
      _ ≤ 1 := by
        apply max_le
        · calc
            _ ≤ (C (-u)).natDegree + (X : Polynomial E).natDegree := natDegree_mul_le
            _ = 1 := by simp
        · simp
  have hlt : f.natDegree < ((X : Polynomial E)^2).natDegree := by
    simp only [natDegree_X_pow]
    omega
  have hmon : Q.Monic := by
    dsimp [Q]
    apply monic_X_pow_add
    simpa only [degree_X_pow] using degree_lt_degree hlt
  have hd : Q.natDegree = 2 := by
    dsimp [Q]
    rw [natDegree_add_eq_left_of_natDegree_lt hlt, natDegree_X_pow]
  have hroot : aeval w Q = 0 := by
    simp only [Q, f, map_add, map_mul, map_pow, aeval_X, aeval_C, map_one, map_neg]
    change w^2 + (-(w+w⁻¹)*w + 1) = 0
    calc
      _ = 1 - w⁻¹*w := by ring
      _ = 0 := by rw [inv_mul_cancel₀ hw, sub_self]
  have hi : IsIntegral E w := ⟨Q, hmon, hroot⟩
  refine ⟨hi, ?_⟩
  exact (natDegree_le_of_dvd (minpoly.dvd E w hroot) hmon.ne_zero).trans_eq hd

-- Main result: K is the cyclotomic field generated by w (not necessarily C).
-- The proof is entirely algebraic and uses the tower degree formula.
theorem HP_minpoly_of_gen {K : Type*} [Field K] [CharZero K] (n : ℕ)
    (hs : (2*n+1).Prime) {w : K} (hw : IsPrimitiveRoot w (2*n+1))
    (hgen : IntermediateField.adjoin ℚ ({w} : Set K) = ⊤) :
    HP ℚ n = minpoly ℚ (w+w⁻¹) := by
  have hspos := hs.pos
  have hn : 0 < n := by have := hs.two_le; omega
  have hw0 := hw.ne_zero hspos.ne'
  have hz := HP_trace_root n hn hw
  have ht : IsIntegral ℚ (w+w⁻¹) := ⟨HP ℚ n, HP_monic ℚ n, hz⟩
  let E := IntermediateField.adjoin ℚ ({w+w⁻¹} : Set K)
  have hquad : IsIntegral E w ∧ (minpoly E w).natDegree ≤ 2 := quadratic_degree_bound hw0
  have hgenE : IntermediateField.adjoin E ({w} : Set K) = ⊤ :=
    IntermediateField.adjoin_eq_top_of_adjoin_eq_top (F := ℚ) (E := E) hgen
  have hrel : Module.finrank E K ≤ 2 := by
    have h := IntermediateField.adjoin.finrank hquad.1
    rw [hgenE, IntermediateField.finrank_top'] at h
    exact h.trans_le hquad.2
  have hE : Module.finrank ℚ E = (minpoly ℚ (w+w⁻¹)).natDegree :=
    IntermediateField.adjoin.finrank ht
  have hiw : IsIntegral ℚ w := by
    refine ⟨X^(2*n+1) - C (1 : ℚ), monic_X_pow_sub_C 1 (by omega), ?_⟩
    simp [hw.pow_eq_one]
  have hK : Module.finrank ℚ K = 2*n := by
    have h := IntermediateField.adjoin.finrank hiw
    rw [hgen, IntermediateField.finrank_top', ← cyclotomic_eq_minpoly_rat hw hspos,
      natDegree_cyclotomic, Nat.totient_prime hs] at h
    omega
  have hbound := Nat.mul_le_mul_left (Module.finrank ℚ E) hrel
  rw [Module.finrank_mul_finrank ℚ E K, hK, hE] at hbound
  have hle : n ≤ (minpoly ℚ (w+w⁻¹)).natDegree := by omega
  apply eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic ht) (HP_monic ℚ n)
    (minpoly.dvd ℚ (w+w⁻¹) hz)
  rw [HP_natDegree]
  exact hle

-- The explicit cyclotomic extension hypothesis discharges the generation condition.
theorem HP_minpoly_cyclotomic {K : Type*} [Field K] [CharZero K] (n : ℕ)
    (hs : (2*n+1).Prime) [IsCyclotomicExtension {2*n+1} ℚ K]
    {w : K} (hw : IsPrimitiveRoot w (2*n+1)) :
    HP ℚ n = minpoly ℚ (w+w⁻¹) := by
  letI : NeZero (2*n+1) := ⟨hs.ne_zero⟩
  have ha : Algebra.adjoin ℚ ({w} : Set K) = ⊤ :=
    IsCyclotomicExtension.adjoin_primitive_root_eq_top hw
  have hle : Algebra.adjoin ℚ ({w} : Set K) ≤
      (IntermediateField.adjoin ℚ ({w} : Set K)).toSubalgebra := by
    apply Algebra.adjoin_le
    intro x hx
    exact IntermediateField.subset_adjoin ℚ _ hx
  rw [ha] at hle
  have hg : IntermediateField.adjoin ℚ ({w} : Set K) = ⊤ := by
    apply top_unique
    intro x _
    exact hle (show x ∈ (⊤ : Subalgebra ℚ K) by simp)
  exact HP_minpoly_of_gen n hs hw hg

-- The two trace recurrences and the original binomial coefficients coincide.
theorem trace_step (n : ℕ) :
    A (n+1) = 3*A n+4*B n ∧ B (n+1) = 2*A n+3*B n := by
  induction n with
  | zero => norm_num [A,B,H]
  | succ n ih =>
    rcases ih with ⟨ha,hb⟩
    change A (n+2) = 3*A (n+1)+4*B (n+1) ∧
      B (n+2) = 2*A (n+1)+3*B (n+1)
    rw [A_rec,B_rec]
    constructor <;> linarith

open PellFinishV4 in
theorem coefs_two_steps (m : ℕ) :
    (coefs 2 (m+2)).1 = 3*(coefs 2 m).1+4*(coefs 2 m).2 ∧
    (coefs 2 (m+2)).2 = 2*(coefs 2 m).1+3*(coefs 2 m).2 := by
  simp only [coefs]
  constructor <;> ring

open PellFinishV4 in
theorem trace_eq_coefs (n : ℕ) :
    ((coefs 2 (2*n+1)).1 : ℤ) = A n ∧
    ((coefs 2 (2*n+1)).2 : ℤ) = B n := by
  induction n with
  | zero => norm_num [coefs,A,B,H]
  | succ n ih =>
    rw [show 2*(n+1)+1=(2*n+1)+2 by omega]
    obtain ⟨hc,hd⟩ := coefs_two_steps (2*n+1)
    obtain ⟨ha,hb⟩ := trace_step n
    constructor
    · rw [hc,ha]
      push_cast
      rw [ih.1,ih.2]
    · rw [hd,hb]
      push_cast
      rw [ih.1,ih.2]

-- Exact composition with the audited v4.2 reduction.
theorem radical_iff_trace (p q r n t : ℕ) (hp : p.Prime) (hq : q.Prime)
    (hr : r.Prime) (hs : (2*n+1).Prime) (ht : t.Prime) :
    PellEquationV4.Equation p q r (2*n+1) t ↔
      t=2 ∧ r=2 ∧ A n=(p:ℤ) ∧ B n=(q:ℤ) := by
  rw [PellEquationV4.radical_iff_pell_coeffs p q r (2*n+1) t hp hq hr hs ht]
  have hh := trace_eq_coefs n
  constructor
  · rintro ⟨_, ht', hr', hp', hq'⟩
    refine ⟨ht',hr',?_,?_⟩
    · rw [← hh.1, hp']
    · rw [← hh.2, hq']
  · rintro ⟨ht',hr',hp',hq'⟩
    refine ⟨by omega,ht',hr',?_,?_⟩
    · exact_mod_cast hh.1.trans hp'
    · exact_mod_cast hh.2.trans hq'

-- Uniform modular test. Only the negative Pell norm and field characteristic
-- different from 2 are needed; the finite-field order proof is a separate task.
theorem norm_obstruction {K : Type*} [Field K] (h2 : (2 : K) ≠ 0)
    (a b : K) (h : a^2-2*b^2 = -1) :
    (a^2+2*b^2=1 ↔ a=0) ∧ (a^2+2*b^2 = -1 ↔ b=0) := by
  constructor
  · constructor
    · intro hp
      have hprod : 2*a^2=0 := by linear_combination h+hp
      have ha : a*a=0 := by
        simpa only [pow_two] using (mul_eq_zero.mp hprod).resolve_left h2
      exact (mul_eq_zero.mp ha).elim id id
    · intro ha
      rw [ha] at h ⊢
      linear_combination -h
  · constructor
    · intro hp
      have h4 : (4 : K) ≠ 0 := by
        have hh := mul_ne_zero h2 h2
        simpa only [show (2 : K)*2=4 by ring] using hh
      have hprod : 4*b^2=0 := by linear_combination hp-h
      have hb : b*b=0 := by
        simpa only [pow_two] using (mul_eq_zero.mp hprod).resolve_left h4
      exact (mul_eq_zero.mp hb).elim id id
    · intro hb
      rw [hb] at h ⊢
      linear_combination h

theorem trace_modular_obstruction (ell n : ℕ) [Fact ell.Prime]
    (h2 : (2 : ZMod ell) ≠ 0) :
    let a := (A n : ZMod ell)
    let b := (B n : ZMod ell)
    (a^2+2*b^2=1 ↔ a=0) ∧ (a^2+2*b^2 = -1 ↔ b=0) := by
  dsimp only
  apply norm_obstruction h2
  have h := congrArg (fun x : ℤ => (x : ZMod ell)) (trace_negative_pell n)
  push_cast at h
  exact h

