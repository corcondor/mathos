#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077
export PYTHONUTF8=1 GIT_TERMINAL_PROMPT=0

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
repo=$(pwd -P)
runtime=$repo/.mathos-codespaces
run_dir=$runtime/goal
formal=$repo/docs/research/nested-binomial/v10_formal
toolchain=leanprover/lean4:v4.35.0
mathlib_commit=56a005855ea17e0b0958f73ec801ae140b0a1679
branch=research/nested-binomial-2026-11-05
export ELAN_HOME=$runtime/elan
export DEEPSEEK_MATHLIB=$runtime/mathlib
export PATH=$ELAN_HOME/bin:$PATH
export MATHLIB_CACHE_DIR=$runtime/mathlib-cache
export DEEPSEEK_CACHE_COMMAND=$repo/.devcontainer/cache-mathlib

fail() { printf '%s\n' "$*" >&2; exit 1; }

command=${1:-help}
[[ $# -le 1 ]] || fail 'Usage: .devcontainer/research {run|auto|auto-stop|auto-status|status|pause|logs|setup|verify}'
if [[ $command == run || $command == auto || $command == autostart ]]; then
    # Keep the value in Bash and export it only to the Python runner.
    export -n MISTRAL_API_KEY
else
    unset MISTRAL_API_KEY
fi
case "$command" in
    run|auto|autostart|auto-stop|auto-status|status|pause|logs|prepare|setup|verify) ;;
    help) printf '%s\n' 'Usage: .devcontainer/research {run|auto|auto-stop|auto-status|status|pause|logs|setup|verify}'; exit 0 ;;
    *) fail "Unknown command: $command" ;;
esac
[[ ! -L $runtime && ! -L $run_dir ]] || fail 'Refusing a symlink for the private runtime or run directory.'
mkdir -p -- "$runtime"
chmod 700 -- "$runtime"
python3 -c 'import sys; assert sys.version_info >= (3, 11), "Python 3.11 or later is required"'

lock_workspace() {
    exec 9>"$runtime/workspace.lock"
    flock -n 9 || fail 'Setup, verification or a research run is already active.'
}

check_pins() {
    [[ $(<"$DEEPSEEK_MATHLIB/lean-toolchain") == "$toolchain" ]] ||
        fail 'Unexpected mathlib Lean toolchain.'
    [[ $(git -C "$DEEPSEEK_MATHLIB" rev-parse HEAD) == "$mathlib_commit" ]] ||
        fail 'Unexpected mathlib commit.'
    local version lean_binary
    version=$(cd -- "$DEEPSEEK_MATHLIB" && "$ELAN_HOME/bin/lean" --version)
    [[ $version == 'Lean (version 4.35.0,'* ]] || fail "Unexpected Lean version: $version"
    # Derive Lake and Lean's locations from Elan, including in remote shells
    # where the executable cannot resolve its own installation directory.
    lean_binary=$(cd -- "$DEEPSEEK_MATHLIB" && "$ELAN_HOME/bin/elan" which lean)
    export LEAN_SYSROOT=${lean_binary%/bin/lean}
    export LAKE_HOME=$LEAN_SYSROOT
}

setup() (
    staging=$(mktemp -d "$runtime/setup.XXXXXXXX")
    trap 'rm -rf -- "$staging"' EXIT
    if [[ ! -x $ELAN_HOME/bin/elan ]]; then
        [[ $(uname -m) == x86_64 ]] || fail 'This Codespaces setup requires x86-64 Linux.'
        archive=$staging/elan.tar.gz
        curl --fail --silent --show-error --location --retry 3 \
            https://github.com/leanprover/elan/releases/download/v4.2.3/elan-x86_64-unknown-linux-gnu.tar.gz \
            --output "$archive"
        printf '%s  %s\n' df0b2b3a439961ffcbb3985214365ffe40f49bc871df04dff268c7d8e21ca8b2 "$archive" |
            sha256sum --check
        tar -xzf "$archive" -C "$staging"
        "$staging/elan-init" -y --no-modify-path --default-toolchain none
    fi
    if ! "$ELAN_HOME/bin/elan" run "$toolchain" lean --version >/dev/null 2>&1; then
        "$ELAN_HOME/bin/elan" toolchain install "$toolchain"
    fi
    if [[ ! -e $DEEPSEEK_MATHLIB ]]; then
        git init -q "$staging/mathlib"
        git -C "$staging/mathlib" remote add origin \
            https://github.com/leanprover-community/mathlib4.git
        git -C "$staging/mathlib" fetch --depth=1 origin "$mathlib_commit"
        git -C "$staging/mathlib" checkout --detach FETCH_HEAD
        mv -- "$staging/mathlib" "$DEEPSEEK_MATHLIB"
    fi
    check_pins
    cd -- "$DEEPSEEK_MATHLIB"
    # Mathlib.Tactic and the explicit imports cover the existing checked modules.
    "$DEEPSEEK_CACHE_COMMAND" Mathlib.Tactic Mathlib.AlgebraicGeometry.EllipticCurve.Weierstrass \
        Mathlib.Data.Nat.ChineseRemainder Mathlib.Data.Nat.Factorization.Basic \
        Mathlib.Data.Nat.GCD.BigOperators Mathlib.NumberTheory.Padics.PadicVal.Basic
)

verify() {
    check_pins
    cd -- "$DEEPSEEK_MATHLIB"
    lake env env -u LD_LIBRARY_PATH python3 "$formal/check_additional_formalization.py" \
        --output-dir "$runtime/verification"
}

smoke() {
    check_pins
    cd -- "$DEEPSEEK_MATHLIB"
    printf '%s\n' 'import Mathlib.Data.Nat.GCD.BigOperators' \
        'example : Nat.gcd 12 8 = 4 := by decide' |
        timeout 120 lake env env -u LD_LIBRARY_PATH bash -c '
            export LEAN_PATH="$LEAN_SYSROOT/lib/lean${LEAN_PATH:+:$LEAN_PATH}"
            exec lean -j1 --stdin
        '
    touch -- "$runtime/verified"
}

case "$command" in
    prepare)
        if [[ ! -f $runtime/verified ]]; then
            nohup bash "$repo/.devcontainer/research" setup </dev/null >>"$runtime/setup.log" 2>&1 &
            printf '%s\n' 'Lean setup started. Use .devcontainer/research logs to follow it.'
        fi
        ;;
    setup) lock_workspace; rm -f -- "$runtime/verified"; setup; smoke ;;
    verify) lock_workspace; verify ;;
    run)
        [[ -n ${MISTRAL_API_KEY:-} ]] ||
            fail 'Set MISTRAL_API_KEY in GitHub Codespaces secrets, then stop and reopen this Codespace.'
        lock_workspace
        [[ $(git branch --show-current) == "$branch" ]] || fail "Open the $branch branch first."
        [[ -f $runtime/verified ]] || fail 'Setup must pass first. Run .devcontainer/research setup.'
        check_pins
        mkdir -p -- "$run_dir"
        if [[ -f $run_dir/state.json ]]; then
            printf '%s\n' 'Resuming the run saved in this Codespace.'
        else
            printf '%s\n' 'Starting a new run with the checked-in Lean modules. The earlier 179-action state was not imported.'
        fi
        printf '%s\n' 'Using the standard DeepSeek research settings.'
        options=()
        if [[ -n ${MATHOS_RESEARCH_MAX_ACTIONS:-} ]]; then
            options+=(--max-actions "$MATHOS_RESEARCH_MAX_ACTIONS")
        fi
        if [[ -n ${MATHOS_RESEARCH_MAX_HOURS:-} ]]; then
            options+=(--max-hours "$MATHOS_RESEARCH_MAX_HOURS")
        fi
        if [[ -n ${MATHOS_RESEARCH_MAX_COMPLETION_TOKENS:-} ]]; then
            options+=(--max-completion-tokens "$MATHOS_RESEARCH_MAX_COMPLETION_TOKENS")
        fi
        if [[ -n ${MATHOS_RESEARCH_MAX_API_CALLS:-} ]]; then
            options+=(--max-api-calls "$MATHOS_RESEARCH_MAX_API_CALLS")
        fi
        MISTRAL_API_KEY=$MISTRAL_API_KEY python3 -u "$formal/deepseek_goal.py" run --run-dir "$run_dir" \
            --run-origin codespaces "${options[@]}" \
            2>&1 | tee -a "$run_dir/runner.log"
        ;;
    auto)
        [[ -n ${MISTRAL_API_KEY:-} ]] ||
            fail 'Existing MISTRAL_API_KEY must be accessible in this Codespace.'
        [[ $(git branch --show-current) == "$branch" ]] || fail "Open the $branch branch first."
        [[ -f $runtime/verified ]] || fail 'Lean setup must pass before enabling the autopilot.'
        touch "$runtime/autopilot.enabled"
        bash "$repo/.devcontainer/research" autostart
        ;;
    autostart)
        [[ -f $runtime/autopilot.enabled ]] || exit 0
        [[ -n ${MISTRAL_API_KEY:-} ]] ||
            fail 'Autopilot enabled, but the existing Codespaces API secret is unavailable.'
        nohup python3 -u "$repo/.devcontainer/research_autopilot.py" \
            </dev/null >>"$runtime/autopilot.log" 2>&1 &
        printf '%s\n' 'Research autopilot launched. Its private log is .mathos-codespaces/autopilot.log.'
        ;;
    auto-stop)
        rm -f "$runtime/autopilot.enabled"
        if [[ -d $run_dir ]]; then printf '%s\n' 'Pause requested by user.' > "$run_dir/PAUSE"; fi
        printf '%s\n' 'Autopilot disabled. Current bounded job will observe PAUSE; its state is retained.'
        ;;
    auto-status)
        if [[ -f $runtime/autopilot.enabled ]]; then
            printf '%s\n' 'Autopilot enabled (not necessarily an active process).'
        else
            printf '%s\n' 'Autopilot disabled.'
        fi
        if [[ -f $runtime/autopilot-ledger.json ]]; then
            cat "$runtime/autopilot-ledger.json"
        fi
        if [[ -f $runtime/autopilot.log ]]; then tail -n 18 "$runtime/autopilot.log"; fi
        ;;
    status|pause)
        if [[ ! -d $run_dir ]]; then
            printf '%s\n' 'No Codespaces run has started. The checked-in proof modules are available.'
        else
            if [[ $command == status ]]; then
                if [[ -f $run_dir/running.lock ]] && ! flock -n "$run_dir/running.lock" true; then
                    printf '%s\n' 'Runner or proof worker is active.'
                else
                    printf '%s\n' 'No active process. The status below is the last checkpoint.'
                fi
            fi
            python3 "$formal/deepseek_goal.py" "$command" --run-dir "$run_dir" --summary
        fi
        ;;
    logs)
        if [[ -f $run_dir/runner.log ]]; then
            tail -n 80 -- "$run_dir/runner.log"
        elif [[ -f $runtime/setup.log ]]; then
            tail -n 80 -- "$runtime/setup.log"
        else
            printf '%s\n' 'No runner log yet.'
        fi
        ;;
esac
